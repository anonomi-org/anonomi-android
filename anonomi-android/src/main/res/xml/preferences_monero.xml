<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<!-- persistent="false" below: these keys are also written by
	     SecurePrefsManager, and the framework would persist the value in
	     plaintext over the ciphertext.

	     No useSimpleSummaryProvider on those either. It prints the value as
	     the summary, which for the private view key means putting the key on
	     screen, and it has no way to say "could not be read" - it would call
	     an undecryptable value unset. MoneroSettingsFragment installs
	     SecureSummaryProvider instead. The rate keeps the simple provider: it
	     is never encrypted. -->

	<PreferenceCategory
		android:layout="@layout/preferences_category"
		android:title="@string/pref_category_monero_wallet">

		<EditTextPreference
			android:key="pref_key_primary_address"
			android:persistent="false"
			android:title="@string/pref_primary_address_title"
			android:hint="@string/pref_primary_address_hint"
			android:inputType="text"
			app:iconSpaceReserved="false"
			app:singleLineTitle="false" />
		<EditTextPreference
			android:key="pref_key_private_view_key"
			android:persistent="false"
			android:title="@string/pref_private_view_key_title"
			android:hint="@string/pref_private_view_key_hint"
			android:inputType="text"
			app:iconSpaceReserved="false"
			app:singleLineTitle="false" />

	</PreferenceCategory>

	<PreferenceCategory
		android:layout="@layout/preferences_category"
		android:title="@string/pref_category_monero_config"
		app:allowDividerAbove="true">

		<EditTextPreference
			android:key="pref_key_monero_rate"
			android:title="@string/pref_monero_rate_title"
			android:hint="@string/pref_monero_rate_hint"
			android:inputType="numberDecimal"
			app:iconSpaceReserved="false"
			app:singleLineTitle="false"
			app:useSimpleSummaryProvider="true" />

		<EditTextPreference
			android:key="pref_key_monero_currency"
			android:title="@string/pref_monero_currency_title"
			android:hint="@string/pref_monero_currency_hint"
			android:inputType="textCapCharacters"
			app:iconSpaceReserved="false"
			app:singleLineTitle="false"
			app:useSimpleSummaryProvider="true" />

		<EditTextPreference
			android:key="pref_key_minor_index_key"
			android:persistent="false"
			android:title="@string/pref_minor_index_title"
			android:hint="@string/pref_minor_index_hint"
			android:inputType="number"
			app:iconSpaceReserved="false"
			app:singleLineTitle="false" />

	</PreferenceCategory>

</PreferenceScreen>
